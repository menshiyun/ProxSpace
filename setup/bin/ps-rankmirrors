if [ ! -f  /etc/pacman.d/mirrorlist.msys.backup ]; then
	cp /etc/pacman.d/mirrorlist.msys /etc/pacman.d/mirrorlist.msys.backup	
fi
if [ ! -f  /etc/pacman.d/mirrorlist.ucrt64.backup ]; then
	cp /etc/pacman.d/mirrorlist.ucrt64 /etc/pacman.d/mirrorlist.ucrt64.backup
fi

echo "Ranking msys mirrors"
rankmirrors -v --repo msys /etc/pacman.d/mirrorlist.msys.backup | tee /etc/pacman.d/mirrorlist.msys
echo "Ranking ucrt64 mirrors"
rankmirrors -v --repo ucrt64 /etc/pacman.d/mirrorlist.ucrt64.backup  | tee /etc/pacman.d/mirrorlist.ucrt64
		